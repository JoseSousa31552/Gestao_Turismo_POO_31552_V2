<Window x:Class="Turismo_V1.Views.BookingCommand"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Turismo_V1.Views"
        mc:Ignorable="d"
        Title="Confirm Reservation"
        Height="550" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#000000" Offset="0"/>
                <GradientStop Color="DarkGoldenrod" Offset="2"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel Width="400" VerticalAlignment="Center">

            <TextBlock Text="CONFIRM BOOKING" Foreground="White" FontSize="28" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,30">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FFD700" BlurRadius="20" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>

            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="LODGING NAME" Foreground="#D4AF37" FontSize="12" FontWeight="Bold" Margin="5,0,0,5"/>
                    <Border CornerRadius="5" Background="#202020" BorderBrush="#444" BorderThickness="1">
                        <TextBox Text="{Binding Lodging.NameHomeLodging}"
                                 IsReadOnly="True"
                                 Background="Transparent" Foreground="White" BorderThickness="0"
                                 FontSize="14" Padding="10"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <TextBlock Text="AVAILABILITY" Foreground="#D4AF37" FontSize="12" FontWeight="Bold" Margin="5,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="5" Background="#202020" BorderBrush="#444" BorderThickness="1" Width="170">
                            <TextBox Text="{Binding Lodging.DateStart, StringFormat={}{0:dd/MM/yyyy}}" 
                                     IsReadOnly="True"
                                     Background="Transparent" Foreground="Gray" BorderThickness="0"
                                     FontSize="14" Padding="10" HorizontalContentAlignment="Center"/>
                        </Border>

                        <TextBlock Text="TO" Foreground="#D4AF37" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>

                        <Border CornerRadius="5" Background="#202020" BorderBrush="#444" BorderThickness="1" Width="170">
                            <TextBox Text="{Binding Lodging.DateEnd, StringFormat={}{0:dd/MM/yyyy}}" 
                                     IsReadOnly="True"
                                     Background="Transparent" Foreground="Gray" BorderThickness="0"
                                     FontSize="14" Padding="10" HorizontalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,15">
                    <TextBlock Text="CHECK-IN DATE" Foreground="#D4AF37" FontSize="12" FontWeight="Bold" Margin="5,0,0,5"/>
                    <Border CornerRadius="5" Background="#202020" BorderBrush="#444" BorderThickness="1">
                        <DatePicker SelectedDate="{Binding CheckIn}"
                                    Foreground="Black"
                                    FontSize="14" VerticalContentAlignment="Center"
                                    Height="40" Padding="5"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,0,15">
                    <TextBlock Text="CHECK-OUT DATE" Foreground="#D4AF37" FontSize="12" FontWeight="Bold" Margin="5,0,0,5"/>
                    <Border CornerRadius="5" Background="#202020" BorderBrush="#444" BorderThickness="1">
                        <DatePicker SelectedDate="{Binding CheckOut}"
                                    Foreground="Black"
                                    FontSize="14" VerticalContentAlignment="Center"
                                    Height="40" Padding="5"/>
                    </Border>
                </StackPanel>

                <Button Grid.Row="5" Command="{Binding ConfirmCommand}" 
                        Content="CONFIRM RESERVATION" Height="45"
                        FontSize="16" FontWeight="Bold" Foreground="Black" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" CornerRadius="22">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#DAA520" Offset="0"/>
                                        <GradientStop Color="#FFD700" Offset="0.5"/>
                                        <GradientStop Color="#DAA520" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>
        </StackPanel>
    </Grid>
</Window>
<Window x:Class="Turismo_V1.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Turismo_V1.Views"
        mc:Ignorable="d"
        Title="Login" Height="500" Width="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Border CornerRadius="25" BorderThickness="3">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#B8860B" Offset="0"/>
                <GradientStop Color="#FFF8DC" Offset="0.5"/>
                <GradientStop Color="#B8860B" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#000000" Offset="0"/>
                <GradientStop Color="#292000" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Border CornerRadius="25" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Turismo App" Foreground="#886600" VerticalAlignment="Center" 
                               Margin="20,0,0,0" FontWeight="Bold" FontFamily="Segoe UI"/>

                    <Button Content="X" Grid.Column="2" Click="btnClose_Click"
                            Foreground="White" Background="Transparent" BorderThickness="0"
                            FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                </Grid>

                <StackPanel Grid.Row="1" Width="300" VerticalAlignment="Center">

                    <TextBlock Text="SIGN IN" Foreground="White" FontSize="32" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,40">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FFD700" BlurRadius="20" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock Text="USERNAME" Foreground="#D4AF37" FontSize="12" FontWeight="Bold" Margin="5,0,0,5"/>
                    <Border CornerRadius="5" Background="#202020" BorderBrush="#444" BorderThickness="1" Margin="0,0,0,20">
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="White" BorderThickness="0"
                                 FontSize="14" Padding="10" CaretBrush="Gold"/>
                    </Border>

                    <TextBlock Text="PASSWORD" Foreground="#D4AF37" FontSize="12" FontWeight="Bold" Margin="5,0,0,5"/>
                    <Border CornerRadius="5" Background="#202020" BorderBrush="#444" BorderThickness="1" Margin="0,0,0,30">
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="White" BorderThickness="0"
                                 FontSize="14" Padding="10" CaretBrush="Gold"/>
                    </Border>

                    <Button Command="{Binding LoginCommand}" Content="LOGIN" Height="45"
                            FontSize="16" FontWeight="Bold" Foreground="Black" Cursor="Hand" Margin="0,0,0,15">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" CornerRadius="22">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#DAA520" Offset="0"/>
                                            <GradientStop Color="#FFD700" Offset="0.5"/>
                                            <GradientStop Color="#DAA520" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Command="{Binding RegistryCommand}" Content="REGISTRY" Height="45"
        FontSize="16" FontWeight="Bold" Foreground="Black" Cursor="Hand" Margin="0,0,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" CornerRadius="22">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#DAA520" Offset="0"/>
                                            <GradientStop Color="#FFD700" Offset="0.5"/>
                                            <GradientStop Color="#DAA520" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
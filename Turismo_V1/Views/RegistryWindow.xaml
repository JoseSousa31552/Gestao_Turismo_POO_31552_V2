<Window x:Class="Turismo_V1.Views.RegistryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Registry"
        Height="550" Width="800"
        WindowStartupLocation="CenterScreen">

 
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#000000" Offset="0"/>
                <GradientStop Color="DarkGoldenrod" Offset="2"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel Width="320" VerticalAlignment="Center">

            <TextBlock Text="REGISTRY" Foreground="White" FontSize="32" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,40">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FFD700" BlurRadius="20" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- USERNAME -->
            <TextBlock Text="USERNAME" Foreground="#D4AF37" FontSize="12" FontWeight="Bold" Margin="5,0,0,5"/>
            <Border CornerRadius="5" Background="#202020" BorderBrush="#444" BorderThickness="1" Margin="0,0,0,10">
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" Foreground="White" BorderThickness="0"
                         FontSize="14" Padding="10" CaretBrush="Gold"/>
            </Border>

            <!-- PASSWORD -->
            <TextBlock Text="PASSWORD" Foreground="#D4AF37" FontSize="12" FontWeight="Bold" Margin="5,0,0,5"/>
            <Border CornerRadius="5" Background="#202020" BorderBrush="#444" BorderThickness="1" Margin="0,0,0,10">
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" Foreground="White" BorderThickness="0"
                         FontSize="14" Padding="10" CaretBrush="Gold"/>
            </Border>

            <!-- NAME -->
            <TextBlock Text="NAME" Foreground="#D4AF37" FontSize="12" FontWeight="Bold" Margin="5,0,0,5"/>
            <Border CornerRadius="5" Background="#202020" BorderBrush="#444" BorderThickness="1" Margin="0,0,0,10">
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" Foreground="White" BorderThickness="0"
                         FontSize="14" Padding="10" CaretBrush="Gold"/>
            </Border>

            <!-- EMAIL -->
            <TextBlock Text="EMAIL" Foreground="#D4AF37" FontSize="12" FontWeight="Bold" Margin="5,0,0,5"/>
            <Border CornerRadius="5" Background="#202020" BorderBrush="#444" BorderThickness="1" Margin="0,0,0,10">
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" Foreground="White" BorderThickness="0"
                         FontSize="14" Padding="10" CaretBrush="Gold"/>
            </Border>

            <!-- PHONE -->
            <TextBlock Text="PHONE NUMBER" Foreground="#D4AF37" FontSize="12" FontWeight="Bold" Margin="5,0,0,5"/>
            <Border CornerRadius="5" Background="#202020" BorderBrush="#444" BorderThickness="1" Margin="0,0,0,10">
                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" Foreground="White" BorderThickness="0"
                         FontSize="14" Padding="10" CaretBrush="Gold"/>
            </Border>

            <!-- REGISTRY BUTTON -->
            <Button Command="{Binding RegistryCommand}" Content="REGISTRY" Height="45"
        FontSize="16" FontWeight="Bold" Foreground="Black" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="22">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#DAA520" Offset="0"/>
                                    <GradientStop Color="#FFD700" Offset="0.5"/>
                                    <GradientStop Color="#DAA520" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>


        </StackPanel>

    </Grid>
</Window>
